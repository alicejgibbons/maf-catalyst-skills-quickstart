<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>skills_quickstart</RootNamespace>
    <!-- MAF's Skills API (AgentSkill, AgentSkillsProvider, AgentSkillsProviderBuilder, ...) is marked
         [Experimental("MAAI001")] upstream - evaluation purposes only for now, same as PR #63's own
         examples/SkillsDemo. -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately a ProjectReference to the CLONED PR #67 branch source (invokerdrop-1, based on
         master with PR #63's skills support already merged), not the released
         Diagrid.AI.Microsoft.AgentFramework NuGet package (1.0.10, which predates both). This is the
         whole point of this sample: prove the PRs' code, not the shipped package. -->
    <ProjectReference Include="../dotnet-ai/src/Diagrid.AI.Microsoft.AgentFramework/Diagrid.AI.Microsoft.AgentFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The file-based skill's SKILL.md (+ resources) needs to travel alongside the built app. -->
    <Content Include="skills\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
